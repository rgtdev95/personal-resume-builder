# Copy this file to .env and fill in your own key.
# .env is gitignored — it never gets committed.

OPENAI_API_KEY=

# Optional overrides (default model: gpt-6-luna — fastest/cheapest of the
# GPT-6 family; gpt-6-sol or gpt-6-astra trade cost for stronger tailoring):
# OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
